{
  "name": "omp-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Oh My Pi Desktop — a native shell around the oh-my-pi (omp) coding agent, built on the Hermes Agent Desktop architecture.",
  "main": "desktop-shell/main.cjs",
  "license": "MIT",
  "author": {
    "name": "Oh My Pi Desktop",
    "email": "desktop@omp.sh"
  },
  "homepage": "https://omp.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/akanopro001/omp-desktop.git"
  },
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/make-icon.mjs",
    "desktop:dev": "electron desktop-shell/main.cjs",
    "desktop:verify": "node scripts/run-desktop-verify.mjs",
    "desktop:dist": "electron-builder --publish never",
    "desktop:dist:win": "electron-builder --win --publish never",
    "desktop:dist:linux": "electron-builder --linux --publish never",
    "desktop:dist:mac": "electron-builder --mac --publish never",
    "desktop:dist:dir": "electron-builder --dir --publish never",
    "desktop:runtime:win": "node scripts/fetch-omp-runtime.mjs win32-x64"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
